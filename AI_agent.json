        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"contents\": [{\n    \"parts\": [{\n      \"text\": {{ JSON.stringify($json.voice) }}\n    }]\n  }],\n  \"generationConfig\": {\n    \"responseModalities\": [\"AUDIO\"],\n    \"speechConfig\": {\n      \"voiceConfig\": {\n        \"prebuiltVoiceConfig\": {\n          \"voiceName\": \"Kore\"\n        }\n      }\n    }\n  }\n}",
        "options": {}
      },
      "id": "6ed91bcd-3879-4640-a73e-dbf95f715409",
      "name": "HTTP Request",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.4,
      "position": [
        -288,
        480
      ]
    },
    {
      "parameters": {
        "jsCode": "const item = $input.first();\n\n// Gemini TTS returns raw PCM audio as base64 inside the response\nconst part = item.json.candidates[0].content.parts[0];\nconst b64 = part.inlineData.data;\nconst mime = part.inlineData.mimeType || \"audio/L16;codec=pcm;rate=24000\";\n\n// Parse sample rate from mime type (defaults to 24000)\nconst rateMatch = mime.match(/rate=(\\d+)/);\nconst sampleRate = rateMatch ? parseInt(rateMatch[1], 10) : 24000;\nconst numChannels = 1;\nconst bitsPerSample = 16;\n\nconst pcm = Buffer.from(b64, \"base64\");\nconst byteRate = (sampleRate * numChannels * bitsPerSample) / 8;\nconst blockAlign = (numChannels * bitsPerSample) / 8;\nconst dataSize = pcm.length;\n\n// Build 44-byte WAV header\nconst header = Buffer.alloc(44);\nheader.write(\"RIFF\", 0);\nheader.writeUInt32LE(36 + dataSize, 4);\nheader.write(\"WAVE\", 8);\nheader.write(\"fmt \", 12);\nheader.writeUInt32LE(16, 16);\nheader.writeUInt16LE(1, 20); // PCM format\nheader.writeUInt16LE(numChannels, 22);\nheader.writeUInt32LE(sampleRate, 24);\nheader.writeUInt32LE(byteRate, 28);\nheader.writeUInt16LE(blockAlign, 32);\nheader.writeUInt16LE(bitsPerSample, 34);\nheader.write(\"data\", 36);\nheader.writeUInt32LE(dataSize, 40);\n\nconst wav = Buffer.concat([header, pcm]);\n\nreturn [\n  {\n    json: { fileName: \"voice.wav\" },\n    binary: {\n      data: await this.helpers.prepareBinaryData(wav, \"voice.wav\", \"audio/wav\"),\n    },\n  },\n];\n"
      },
      "id": "cacc7767-832b-4989-ba20-e85b7959aef3",
      "name": "Convert PCM to WAV",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -64,
        480
      ]
